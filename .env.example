# --- Gmail OAuth2 (required) ---
# From your Google Cloud OAuth client. See README → Setup.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Notion (required) ---
# Internal integration token from notion.so/my-integrations
NOTION_API_KEY=
# 32-character ID from your database URL
NOTION_DATABASE_ID=

# --- Server ---
PORT=3000

# --- Polling ---
# Minutes between Gmail polls.
POLL_INTERVAL_MINUTES=2

# --- Ollama (local LLM) ---
# Defaults shown; uncomment to override.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini
